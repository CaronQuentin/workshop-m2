# Copiez ce fichier en .env puis adaptez. AUCUN secret réel ici.
# En production, ces valeurs sont injectées depuis HashiCorp Vault par Ansible
# (voir ansible/bootstrap.yml). Le .env n'est utilisé que pour le démonstrateur local.

# --- Base de données (fictive) ---
POSTGRES_USER=payuser
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=payments

# --- JWT (auth-service émet, payment-api vérifie) ---
JWT_SECRET=dev_jwt_secret_change_me
JWT_ALG=HS256
JWT_TTL_SECONDS=900

# --- Vault (mode dev pour le démonstrateur) ---
VAULT_DEV_TOKEN=root-dev-token

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=admin_dev_only

# --- Moteur de remédiation ---
# Jeton attendu dans l'en-tête X-Remediation-Token des alertes (anomaly-detector).
REMEDIATION_TOKEN=dev_remediation_token_change_me

# --- Compte technique de la transaction de contrôle (partagé auth-service <-> remédiation) ---
CTL_USER=ctl-bot
CTL_PASSWORD=ctl_control_password_change_me

# --- Assistant RAG / Ollama ---
# Ollama tourne sur l'hôte (ou le PC de délestage IA). Sous Docker Desktop/WSL2 :
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Modèle local <= 8 milliards de paramètres (cf. dossier 3.3) :
OLLAMA_MODEL=llama3.1:8b

# --- Consigne additionnelle 1 : 2FA back-office (face-auth + MQTT + ESP8266) ---
MQTT_PUB_USER=auth-pub
MQTT_PUB_PASS=change_me_mqtt_pub
MQTT_ESP_USER=esp-led
MQTT_ESP_PASS=change_me_mqtt_esp
MQTT_TOPIC=swap/backoffice/led
FACE_THRESHOLD=0.5
BACKOFFICE_MAX_ATTEMPTS=2
BACKOFFICE_BLOCK_SECONDS=300
